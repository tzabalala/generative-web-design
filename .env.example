# Copy this file to "backend/.env" and fill in the real values.
# The real .env is NEVER committed to Git (see .gitignore).

# Your API key from console.anthropic.com
ANTHROPIC_API_KEY=

# Which Claude model to use:
#   dev  = CLAUDE_MODEL_DEV  (cheaper and faster, for development and testing)
#   demo = CLAUDE_MODEL_DEMO (stronger, for the final demo)
# Leave this out (or "dev") for everyday work. Set to "demo" for the viva.
MODEL_PROFILE=dev

# Model used for development/iteration (cheaper, faster)
CLAUDE_MODEL_DEV=claude-haiku-4-5-20251001

# Model used for the final demo (more capable)
CLAUDE_MODEL_DEMO=claude-sonnet-5

# Port the backend (Node.js/Express) listens on
PORT=3000

# Maximum retries in the validation loop (axe-core / responsive checker)
MAX_VALIDATION_RETRIES=3

# Iteration limit per session (for UX reasons, not cost)
MAX_ITERATIONS_PER_SESSION=15

# Real layout check (opens each page at phone / tablet / desktop size).
# "on" (default) or "off" (e.g. to reproduce the earlier static-only results).
VISUAL_RESPONSIVE_CHECK=on
