# Αντιγράψτε αυτό το αρχείο σε ".env" και συμπληρώστε τις πραγματικές τιμές.
# Το πραγματικό .env ΔΕΝ ανεβαίνει ποτέ στο Git (βλ. .gitignore).

# Το API key σου από το console.anthropic.com
ANTHROPIC_API_KEY=

# Ποιο μοντέλο να χρησιμοποιείται σε development/iteration (φθηνότερο, πιο γρήγορο)
CLAUDE_MODEL_DEV=claude-haiku-4-5-20251001

# Ποιο μοντέλο να χρησιμοποιείται στο τελικό demo (πιο ισχυρό)
CLAUDE_MODEL_DEMO=claude-sonnet-5

# Πόρτα στην οποία θα "ακούει" το backend (Node.js/Express)
PORT=3000

# Μέγιστες προσπάθειες retry στο validation loop (axe-core / responsive checker)
MAX_VALIDATION_RETRIES=3

# Όριο iterations ανά session (για λόγους UX, όχι κόστους)
MAX_ITERATIONS_PER_SESSION=15
